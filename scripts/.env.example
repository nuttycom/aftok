# Copy this file to .env and configure for your environment

# Aftok server hostname (without https://)
# For local minikube development, use the minikube IP and NodePort:
#   AFTOK_HOST="$(minikube ip):$(kubectl get svc aftok-dev-nginx -n aftok-dev -o jsonpath='{.spec.ports[0].nodePort}')"
# For local docker-compose, use:
#   AFTOK_HOST="localhost:8000"
AFTOK_HOST="aftok.com"

# Your Aftok username and password (for login.sh)
AFTOK_USER=""
AFTOK_PASS=""

# For local development with self-signed certs:
# ALLOW_INSECURE="-k"

# Default project ID (for scripts that require it)
# PID=""
